DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recommendation_db
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false
LOG_LEVEL=INFO
ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS=recommendation.events
KAFKA_CONSUMER_GROUP=recsys-feature-updater
ENABLE_BANDIT_AUTO=true
